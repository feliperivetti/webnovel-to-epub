# Copy to .env. These are development defaults, not production credentials.
APP_NAME="Novel Scraper API"
DEBUG=false

# Empty disables JWT validation for local development.
API_JWT_SECRET=

MAX_CHAPTERS_LIMIT=1000
DEFAULT_TIMEOUT=15
MAX_WORKERS=2

# Optional proxies. Leave empty for direct connections.
PROXY_URL=
PROXY_URL_FALLBACK=
