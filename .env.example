# Copy to .env. These are development defaults, not production credentials.
APP_NAME="Novel Scraper API"
DEBUG=false
# DEBUG=true also enables POST /dev/token in /docs for loopback-only JWT tests.

# Empty disables JWT validation for local development.
API_JWT_SECRET=

MAX_CHAPTERS_LIMIT=1000
DEFAULT_TIMEOUT=15
MAX_WORKERS=2

# Optional proxies. Leave empty for direct connections.
# Webshare HTTP: http://USERNAME:PASSWORD@PROXY_ADDRESS:PORT
# Use username/password authentication for both local and hosted execution.
# Choose one proxy as primary and optionally another as fallback; no list rotation.
PROXY_URL=
PROXY_URL_FALLBACK=
