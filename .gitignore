/outputs/
*.epub
*.log

# Legacy output locations, before the outputs/ reorganization
/logs/
/diagnostics/
/benchmarks.jsonl

# Local credentials; the example contains development defaults only
.env
.env.*
!.env.example

# Editor settings
.vscode/
.idea/
*.swp
*.swo

# Local experiments
/examples/
/tinkering/

# Operating system metadata
.DS_Store
Thumbs.db
desktop.ini
